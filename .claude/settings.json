{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write",
      "Bash(pnpm *)", "Bash(npx *)", "Bash(node *)", "Bash(turbo *)",
      "Bash(git *)", "Bash(gh pr *)", "Bash(gh issue *)",
      "Bash(supabase *)",
      "Bash(eas build --profile preview*)", "Bash(eas build --profile development*)",
      "Bash(eas update --branch preview*)",
      "Bash(maestro *)", "Bash(python *)", "Bash(python3 *)", "Bash(uv *)", "Bash(ruff *)", "Bash(pytest *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(mkdir *)", "Bash(jq *)", "Bash(wc *)", "Bash(head *)", "Bash(tail *)"
    ],
    "deny": [
      "Bash(sudo *)", "Bash(rm -rf *)",
      "Bash(git push --force*)", "Bash(git push -f *)",
      "Bash(eas submit *)", "Bash(eas update --branch production*)",
      "Bash(supabase db reset --linked*)", "Bash(supabase db push*)",
      "Read(./.env)", "Read(./.env.*)", "Read(./**/.env)", "Read(./**/.env.*)",
      "Edit(./.env)", "Edit(./.env.*)", "Write(./.env)", "Write(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh", "args": [], "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh", "args": [], "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.sh", "args": [], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.sh", "args": [], "timeout": 60 },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-catalog.sh", "args": [], "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-quality-gate.sh", "args": [], "timeout": 600 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-notes.sh", "args": [], "timeout": 20 }
        ]
      }
    ]
  }
}
